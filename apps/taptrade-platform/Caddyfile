# Production Caddyfile — Path A single-box, two single-origin hosts.
# Validated topology (2026-05-17, see DEMO_DEPLOYMENT_PLAN.md):
#   - Each app is ONE origin. The auth cookie is host-only + SameSite=Lax,
#     so page + /api + /ws MUST share a hostname or auth/WS break.
#   - Caddy upgrades /ws to the gateway (Next.js does not proxy WS).
#   - Caddy auto-provisions Let's Encrypt TLS. DNS is proxied (orange-cloud)
#     through Cloudflare; CF SSL mode must be "Full (Strict)" so CF validates
#     the origin cert. ACME HTTP-01 challenges pass through CF to Caddy.
#   - Firewall :80/:443 to Cloudflare IP ranges (https://cloudflare.com/ips)
#     so requests cannot bypass the edge and forge CF-IPCountry.
#
# Container names match docker-compose.yml (predict_gateway:18080) and
# docker-compose.demo.yml (predict_player:3000, predict_office:3000).

{
	email ops@99rtp.io
}

# ---- Player (public demo) ----
demo.99rtp.io {
	@chatApi path /chat/api/*
	handle @chatApi {
		uri strip_prefix /chat
		reverse_proxy predict_rocketchat:3000
	}
	@chatRoot path /chat /chat/
	redir @chatRoot /chat/channel/global 302
	@chat path /chat/*
	handle @chat {
		reverse_proxy predict_rocketchat:3000 {
			header_down -X-Frame-Options
			header_down +Content-Security-Policy "frame-ancestors 'self' https://demo.99rtp.io"
		}
	}
	@backend path /api/* /admin/* /ws /ws/*
	handle @backend {
		# Geo signal trust chain (geo gate, GEO_COUNTRY_HEADER=CF-IPCountry):
		#   - X-Geo-Country is never legitimate at this hop (only an
		#     in-Caddy GeoIP module would set it) — strip it so a client
		#     can't smuggle a value past a misconfigured GEO_COUNTRY_HEADER.
		#   - CF-IPCountry is set by Cloudflare (orange-cloud proxy) and CF
		#     overwrites any client-supplied copy, so it must be FORWARDED
		#     here. Before enabling the geo gate, flip DNS to proxied and
		#     firewall :80/:443 to Cloudflare IP ranges so requests cannot
		#     bypass the edge and forge it (see
		#     docs/compliance/geofencing-kyc.md "Edge geo signal").
		reverse_proxy predict_gateway:18080 {
			header_up -X-Geo-Country
			# Anti-spoof edge-auth (audit SEC-03): strip any client copy, then
			# stamp the shared secret the gateway checks under
			# GEO_TRUSTED_PROXY_MODE=require + EDGE_SHARED_SECRET. Set the
			# {$EDGE_SHARED_SECRET} env on the Caddy container to the same
			# value as the gateway. A direct origin request lacks this header
			# and is denied on money-path routes.
			header_up -X-Edge-Auth
			header_up X-Edge-Auth "{$EDGE_SHARED_SECRET}"
			# Rate-limit keying (incident 2026-08-16): the gateway keys its
			# public-read limiter on the client IP, honoring X-Forwarded-For
			# only from GATEWAY_TRUSTED_PROXY_CIDRS. Caddy's default XFF
			# appends OUR peer — the Cloudflare edge — so the gateway would
			# key on ~200 rotating CF addresses. Pin XFF to CF-Connecting-IP
			# (the authoritative client, which CF overwrites on every request)
			# so one visitor is one bucket. Safe because :80/:443 are
			# firewalled to CF ranges, so the header cannot be forged by a
			# direct-to-origin caller.
			header_up -X-Forwarded-For
			header_up X-Forwarded-For "{http.request.header.CF-Connecting-IP}"
		}
	}
	handle {
		reverse_proxy predict_player:3000
	}
}

# ---- Backoffice (basic-auth gated; keeps it out of crawlers/uninvited eyes) ----
office.99rtp.io {
	# Narrowed from /api/* to /api/v1/* so the office's own App Router proxies
	# under /api/auth/* (and /api/fixtures, etc.) reach predict_office instead
	# of being intercepted and 401'd by the gateway. Gateway public/admin
	# routes all live under /api/v1/* (see cmd/gateway/main.go publicPrefixes
	# + handlers.go) and /admin/*, so this matcher still covers them.
	@backend path /api/v1/* /admin/* /ws /ws/*
	handle @backend {
		# Same geo-header hygiene as the player host (see comment there).
		reverse_proxy predict_gateway:18080 {
			header_up -X-Geo-Country
			header_up -X-Edge-Auth
			header_up X-Edge-Auth "{$EDGE_SHARED_SECRET}"
			# Rate-limit keying (incident 2026-08-16): the gateway keys its
			# public-read limiter on the client IP, honoring X-Forwarded-For
			# only from GATEWAY_TRUSTED_PROXY_CIDRS. Caddy's default XFF
			# appends OUR peer — the Cloudflare edge — so the gateway would
			# key on ~200 rotating CF addresses. Pin XFF to CF-Connecting-IP
			# (the authoritative client, which CF overwrites on every request)
			# so one visitor is one bucket. Safe because :80/:443 are
			# firewalled to CF ranges, so the header cannot be forged by a
			# direct-to-origin caller.
			header_up -X-Forwarded-For
			header_up X-Forwarded-For "{http.request.header.CF-Connecting-IP}"
		}
	}
	# Generate the hash on the box:  docker run --rm caddy:2 caddy hash-password --plaintext 'YOURPASS'
	# then paste it below (Caddy >=2.8 uses `basic_auth`; older uses `basicauth`).
	basic_auth {
		admin REPLACE_WITH_BCRYPT_HASH
	}
	handle {
		reverse_proxy predict_office:3000
	}
}
